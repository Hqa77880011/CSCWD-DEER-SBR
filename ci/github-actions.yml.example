name: Repository checks
on: [push, pull_request, workflow_dispatch]
jobs:
  portable:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.10'
      - run: python -m compileall -q opencood project_tools scripts tests
      - run: python scripts/reproduce.py results
      - run: python -m pip install PyYAML==6.0.1 numpy==1.26.3 scipy==1.11.4 shapely==1.8.5.post1
      - run: python -m unittest discover -s tests -p test_portable_reproduction.py -v
